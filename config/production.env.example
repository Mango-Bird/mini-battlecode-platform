# Offline Phase 11A policy template; does NOT enable Internet bot execution.
BATTLECODE_ENV=production
BATTLECODE_PUBLIC_API_ORIGIN=https://api.example.invalid
BATTLECODE_TRUSTED_ORIGIN=https://app.example.invalid
BATTLECODE_COOKIE_NAME=__Host-battlecode_session
BATTLECODE_COOKIE_SECURE=true
BATTLECODE_COOKIE_HTTP_ONLY=true
BATTLECODE_COOKIE_SAME_SITE=Lax
BATTLECODE_CSRF_POLICY=session-token
BATTLECODE_DB_URL=jdbc:postgresql://db.example.invalid/battlecode?sslmode=verify-full
BATTLECODE_DB_USER=battlecode_runtime
BATTLECODE_DB_PASSWORD=
BATTLECODE_WORKER_ORIGIN=https://worker.example.invalid
BATTLECODE_WORKER_AUTH=mtls
BATTLECODE_WORKER_ISOLATION=microvm
BATTLECODE_ACTIVE_COORDINATORS=1
