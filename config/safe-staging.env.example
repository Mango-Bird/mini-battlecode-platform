# New dedicated runtime; Phase11A full online runtime remains blocked.
BATTLECODE_ENV=staging
BATTLECODE_MODE=SAFE_STAGING_WEB_ONLY
BATTLECODE_EXECUTION=disabled
PORT=10000
STAGING_FRONTEND_ORIGIN=https://your-separate-staging.vercel.app
STAGING_BACKEND_ORIGIN=https://your-separate-staging.onrender.com
# Independent cryptographically random base64url/hex secrets, >=43 characters; never VITE_ values.
STAGING_PROXY_SECRET=
STAGING_CSRF_SECRET=
BATTLECODE_DB_URL=jdbc:postgresql://your-direct-neon-host.neon.tech/staging?sslmode=verify-full
BATTLECODE_DB_USER=battlecode_staging_app
BATTLECODE_DB_PASSWORD=
# Vercel function environment ONLY:
# STAGING_BFF_MODE=SAFE_STAGING_WEB_ONLY
# STAGING_FRONTEND_ORIGIN / STAGING_BACKEND_ORIGIN / STAGING_PROXY_SECRET identical above.
# Vite public environment ONLY:
# VITE_RUNTIME_MODE=SAFE_STAGING_WEB_ONLY
# No VITE_WS_URL, VITE_BOT_API_URL, credentials or secrets.
