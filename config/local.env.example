# Local competitive runtime only. Existing scripts consume the root .env;
# this file documents the environment split, and is not automatically loaded.
BATTLECODE_ENV=local
BATTLECODE_DB_URL=jdbc:postgresql://127.0.0.1:5432/battlecode
BATTLECODE_DB_USER=battlecode_local
BATTLECODE_DB_PASSWORD=
# Provision a unique local password; see root .env.example and existing scripts.
