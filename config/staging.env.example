# Offline Phase 11A policy template, NOT a launch configuration.
# ProductionPreflight.validate(Map) checks declarations only; no online runtime exists.
BATTLECODE_ENV=staging
BATTLECODE_PUBLIC_API_ORIGIN=https://api.staging.example.invalid
BATTLECODE_TRUSTED_ORIGIN=https://app.staging.example.invalid
BATTLECODE_COOKIE_NAME=__Host-battlecode_session
BATTLECODE_COOKIE_SECURE=true
BATTLECODE_COOKIE_HTTP_ONLY=true
BATTLECODE_COOKIE_SAME_SITE=Lax
BATTLECODE_CSRF_POLICY=session-token
BATTLECODE_DB_URL=jdbc:postgresql://db.staging.example.invalid/battlecode?sslmode=verify-full
BATTLECODE_DB_USER=battlecode_runtime
# Inject secret from secret manager; blank intentionally fails validation.
BATTLECODE_DB_PASSWORD=
BATTLECODE_WORKER_ORIGIN=https://worker.staging.example.invalid
BATTLECODE_WORKER_AUTH=mtls
BATTLECODE_WORKER_ISOLATION=microvm
BATTLECODE_ACTIVE_COORDINATORS=1
